#:culture{:id "uga.dish.matoke", :name "Matoke", :country "UGA", :kind :dish, :summary "Group of starchy triploid banana cultivars from the African Great Lakes region; the local name is synonymous with the word \"food\" in Uganda and is considered a national dish there, though it is also a staple crop in Kenya, Tanzania, Rwanda and Burundi.", :url "https://en.wikipedia.org/wiki/Matoke", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "uga.dish.rolex", :name "Rolex", :country "UGA", :kind :dish, :summary "Popular Ugandan street food of a vegetable omelette wrapped in chapati, reflecting a fusion of South Asian culinary traditions introduced by Indian laborers during the colonial railway era with local ingredients.", :url "https://en.wikipedia.org/wiki/Rolex_(food)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "uga.dish.luwombo", :name "Luwombo", :country "UGA", :kind :dish, :summary "Traditional Ugandan stew or sauce prepared using smoked young banana leaves, originating in the Buganda Kingdom in 1887; originally reserved for royalty, now enjoyed across ethnic groups throughout Uganda.", :url "https://en.wikipedia.org/wiki/Luwombo", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "uga.beverage.waragi", :name "Waragi", :country "UGA", :kind :beverage, :summary "Generic term in Uganda for domestic distilled beverages, particularly homemade gin, tracing to British soldiers' introduction of gin during the colonial era and later localized into the industrially-produced Uganda Waragi brand.", :url "https://en.wikipedia.org/wiki/Waragi", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "uga.craft.barkcloth", :name "Barkcloth", :country "UGA", :kind :craft, :summary "Cloth manufactured in Buganda, Uganda for centuries from the bark of the ficus natalensis tree; Uganda's sole representative on the UNESCO Intangible Cultural Heritage Lists, proclaimed a Masterpiece of Oral and Intangible Heritage in 2005.", :url "https://en.wikipedia.org/wiki/Barkcloth", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "uga.festival.imbalu", :name "Imbalu", :country "UGA", :kind :festival, :summary "Public circumcision ceremony practiced by the Bamasaba people of Uganda as a rite of passage for boys into manhood, held at the Mutoto cultural site near Mbale in even-numbered years and recognized by UNESCO as Intangible Cultural Heritage.", :url "https://en.wikipedia.org/wiki/Imbalu", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "uga.heritage.kasubi-tombs", :name "Kasubi Tombs", :country "UGA", :kind :heritage, :summary "Burial grounds for four Buganda kings and royal family members in Kampala, Uganda; designated a UNESCO World Heritage Site in 2001, described as one of the most remarkable buildings using purely vegetal materials in sub-Saharan Africa.", :url "https://en.wikipedia.org/wiki/Kasubi_Tombs", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "uga.heritage.bwindi-impenetrable-national-park", :name "Bwindi Impenetrable National Park", :country "UGA", :kind :heritage, :summary "Protected area in southwestern Uganda and a UNESCO World Heritage Site, notable for protecting nearly half of the world's endangered mountain gorilla population along with over 1,000 plant species and 350 bird species.", :url "https://en.wikipedia.org/wiki/Bwindi_Impenetrable_National_Park", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
